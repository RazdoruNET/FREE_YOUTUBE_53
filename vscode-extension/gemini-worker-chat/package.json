{
  "name": "gemini-worker-chat",
  "displayName": "Gemini via Cloudflare Worker",
  "description": "Модели Gemini в Copilot Chat через Cloudflare Worker: обход блокировки Google по региону IP.",
  "publisher": "razdoru",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "gemini",
    "byok",
    "copilot",
    "chat",
    "language model"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "gemini-worker",
        "displayName": "Gemini (Cloudflare)"
      }
    ],
    "commands": [
      {
        "command": "geminiWorker.setApiKey",
        "title": "Gemini (Worker): задать API-ключ"
      },
      {
        "command": "geminiWorker.clearApiKey",
        "title": "Gemini (Worker): удалить API-ключ"
      },
      {
        "command": "geminiWorker.showStatus",
        "title": "Gemini (Worker): статус"
      }
    ],
    "configuration": {
      "title": "Gemini via Cloudflare Worker",
      "properties": {
        "geminiWorker.baseUrl": {
          "type": "string",
          "default": "https://gemini-gw.djgradoos.workers.dev",
          "markdownDescription": "Адрес шлюза: ваш Cloudflare Worker (`https://gemini-gw.<аккаунт>.workers.dev`) или другой совместимый с Gemini OpenAI-эндпоинт."
        },
        "geminiWorker.fallbackModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "gemini-2.5-flash",
            "gemini-2.5-pro"
          ],
          "markdownDescription": "Модели на случай, если список из API получить не удалось (нет ключа, нет сети)."
        }
      }
    }
  }
}
